{
  "actorSpecification": 1,
  "name": "novig-scraper",
  "title": "Novig Exchange Odds API & Scraper",
  "version": "0.2",
  "description": "Novig exchange markets as a dataset, one row per outcome: game lines and player props with best bid, ask, last trade, taker odds, no-vig fair price, volume and open interest. Reads the documented novigapi.com API: free delayed data with no key, live with your own free key. Independent; not affiliated with Novig.",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Outcomes",
      "views": {
        "overview": {
          "title": "Outcomes",
          "transformation": {
            "fields": [
              "league",
              "event",
              "starts_at",
              "market",
              "description",
              "outcome",
              "line",
              "bid",
              "ask",
              "price_american",
              "fair_probability",
              "fair_american",
              "volume",
              "captured_at"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "league": {
                "label": "League",
                "format": "text"
              },
              "event": {
                "label": "Event",
                "format": "text"
              },
              "starts_at": {
                "label": "Starts",
                "format": "date"
              },
              "market": {
                "label": "Market",
                "format": "text"
              },
              "description": {
                "label": "Description",
                "format": "text"
              },
              "outcome": {
                "label": "Outcome",
                "format": "text"
              },
              "line": {
                "label": "Line",
                "format": "number"
              },
              "bid": {
                "label": "Bid",
                "format": "number"
              },
              "ask": {
                "label": "Ask",
                "format": "number"
              },
              "price_american": {
                "label": "Taker odds",
                "format": "number"
              },
              "fair_probability": {
                "label": "Fair prob.",
                "format": "number"
              },
              "fair_american": {
                "label": "Fair odds",
                "format": "number"
              },
              "volume": {
                "label": "Volume",
                "format": "number"
              },
              "captured_at": {
                "label": "Captured",
                "format": "date"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}
